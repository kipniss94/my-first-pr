# ---------------------------------------------------------------------------
# DocuView configuration
#
# Copy to .env and adjust. Every value below is optional — the defaults shown
# are what the application uses when the variable is absent.
# ---------------------------------------------------------------------------

# --- API service -----------------------------------------------------------

# Port the API listens on. The web app proxies /api/v1/* here.
API_PORT=4000
API_HOST=0.0.0.0

# Where uploads and derived artifacts are written, relative to the repo root.
DATA_DIR=data

# Largest file accepted, in megabytes.
MAX_UPLOAD_MB=250

# How long an uploaded file is kept before the sweeper deletes it, in minutes.
RETENTION_MINUTES=60

# How often the sweeper runs, in seconds.
SWEEP_INTERVAL_SECONDS=300

# How many documents may be processed at the same time. Each one is a separate
# OS process, so this is effectively "how many CPU cores may be busy".
PROCESSING_CONCURRENCY=2

# Wall-clock limit for a single document, in seconds.
PROCESSING_TIMEOUT_SECONDS=180

# Memory ceiling for one processing worker, in megabytes.
PROCESSING_MAX_OLD_SPACE_MB=3072

# Browser origins allowed to call the API directly. Only needed when the web
# app talks to the API cross-origin (see NEXT_PUBLIC_API_BASE below).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Request limits per window.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_UPLOADS=20
RATE_LIMIT_API=600

# Logging. LOG_LEVEL is one of trace|debug|info|warn|error|fatal.
LOG_LEVEL=info
PRETTY_LOGS=true

# --- Optional engines ------------------------------------------------------

# Path to LibreOffice. Found automatically in the usual locations; set it if
# yours lives elsewhere, or set it to `off` to disable Office conversion.
# Note: libreoffice-core alone is not enough — the writer, calc and impress
# filter packages must be installed too.
# LIBREOFFICE_BIN=/usr/bin/soffice

# External DWG -> DXF converter. Without it, DWG uploads get a clear message
# telling the user to save as DXF instead. Placeholders: {input} {indir}
# {output} {outdir}
#
#   ODA File Converter:
#     DWG_CONVERTER_CMD=/usr/bin/ODAFileConverter {indir} {outdir} ACAD2018 DXF 0 1
#   LibreDWG:
#     DWG_CONVERTER_CMD=/usr/bin/dwg2dxf -o {output} {input}
# DWG_CONVERTER_CMD=

# --- Web app ---------------------------------------------------------------

# Where the Next.js server proxies API calls. Used server-side only.
API_INTERNAL_URL=http://127.0.0.1:4000

# Set this to have the *browser* call the API directly instead of going through
# the Next.js proxy. The API's CORS_ORIGINS must then include the site origin.
# NEXT_PUBLIC_API_BASE=http://localhost:4000

# Canonical site URL, used for metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Render the reserved advertising slots. Off by default: stage 1 ships without
# advertising, and the placeholders exist only to keep the layout honest.
NEXT_PUBLIC_ADS_ENABLED=false
