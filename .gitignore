node_modules/
.next/
dist/
out/
*.tsbuildinfo

# Uploaded documents and everything derived from them. Never commit these.
# `data-*` covers the throwaway directories used when smoke-testing.
data/
data-*/

# Generated test documents (`npm run fixtures` recreates them).
fixtures/

# Real CAD files supplied for the format analysis. These are the user's own
# proprietary parts and `my-first-pr` is a PUBLIC repository, so they are
# ignored by default and only ever pushed to the private remote, deliberately,
# with `git add -f`.
samples/*
!samples/README.md
!samples/dimensions.md

# Byte-level analysis reports. Regenerated by scripts/sldprt/inspect.ts, and
# they can echo fragments of the parts they describe.
docs/sldprt/reports/

# Copied from node_modules by the predev/prebuild step, never edited by hand.
apps/web/public/pdf.worker.min.mjs

# Playwright output
test-results/
playwright-report/
blob-report/

.env
.env.local
.env.*.local

*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/
